## Example environment variables for Play2Study
# Copy this file to `.env` and fill real values. Do NOT commit `.env` to git.

# App secrets
SECRET_KEY=replace-with-a-strong-secret

# Database (sqlite example)
DATABASE_URL=sqlite:///./play2study.db

# Google OAuth (register redirect in Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://play2study.kz/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=https://play2study.kz/auth/success
#Firebase 
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-firebase-api-key
# reCAPTCHA v3
RECAPTCHA_SECRET=your-recaptcha-secret
RECAPTCHA_SCORE_THRESHOLD=0.5

# Redis/Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Email (optional)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
PORT=5000

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mydb
DB_HOST=postgres
DB_PORT=5432